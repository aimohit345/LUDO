# App Branding & Mode
NEXT_PUBLIC_BRAND_NAME="LudoArena"
NEXT_PUBLIC_MONEY_MODE="coins" # "coins" | "real"
NEXT_PUBLIC_SUPPORT_EMAIL="support@ludoarena.gg"

# Feature & Compliance Switches
NEXT_PUBLIC_REQUIRE_KYC_FOR_WITHDRAWAL=true
NEXT_PUBLIC_MIN_WITHDRAWAL=100
NEXT_PUBLIC_MAX_WITHDRAWAL=10000
NEXT_PUBLIC_MIN_DEPOSIT=20
NEXT_PUBLIC_MAX_DEPOSIT=25000
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_REFERRAL_BONUS_REFERRER=25
NEXT_PUBLIC_REFERRAL_BONUS_REFEREE=15
NEXT_PUBLIC_MIN_AGE=18
NEXT_PUBLIC_BLOCKED_REGIONS="AS,OD,TS,NL,AP,SK"
NEXT_PUBLIC_ROOM_CODE_REVEAL_MINS=10
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Supabase (Credentials for local or hosted Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Providers
PAYMENT_PROVIDER="mock" # "mock" | "razorpay" | "paytm"
NEXT_PUBLIC_MOCK_PAYMENTS=true
MOCK_PAYMENTS=true

# Razorpay (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="YourSecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecret"
RAZORPAYX_ACCOUNT_NUMBER="2323230000000000"

# Paytm
PAYTM_MID="YOUR_PAYTM_MID"
PAYTM_MERCHANT_KEY="YOUR_PAYTM_KEY"
PAYTM_WEBSITE="WEBSTAGING"

# Email / SMS / AI Providers
RESEND_API_KEY="re_mock_key"
SMS_PROVIDER="mock"
SMS_API_KEY="mock_sms_key"
GEMINI_API_KEY=""

# Security & Cron
CRON_SECRET="ludoarena_super_secret_cron_token_2026"
ENCRYPTION_KEY="ludoarena_aes256_32bytes_secret_key!!"
